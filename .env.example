# =====================================================
# PULSESCORE ENVIRONMENT CONFIGURATION
# =====================================================

# RapidAPI SportAPI Configuration
# Get your API key from: https://rapidapi.com/api-sports/api/sportapi7
SPORTS_API_KEY=your_rapidapi_sportapi_key_here
SPORTS_API_HOST=sportapi7.p.rapidapi.com

# Upstash Redis REST Configuration
# Create a free serverless Redis database at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Active Match & Server Settings
MATCH_ID=17022238
PORT=3000
POLL_INTERVAL=300000
